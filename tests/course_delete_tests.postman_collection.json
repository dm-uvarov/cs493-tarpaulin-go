				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"status code is 204 (1.5 pts)\", function () {",
							"    pm.response.to.have.status(204);",
							"});",
							"",
							"pm.test(\"response body is empty (1.5 pts)\", function () {",
							"    pm.expect(pm.response.text()).to.be.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{admin1_jwt}}",
							"type": "string"
