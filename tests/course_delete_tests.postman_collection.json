		{
			"name": "7. verify instructor courses updated after deletion",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"status code is 200 (1 pt)\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"deleted course not in instructor's courses (2 pts)\", function () {",
							"    const respJSON = pm.response.json();",
							"    const deletedCourseId = parseInt(pm.environment.get('course1_id'));",
							"    if (respJSON.courses) {",
							"        pm.expect(respJSON.courses).to.not.include(deletedCourseId);",
							"    }",
							"});"
						],
