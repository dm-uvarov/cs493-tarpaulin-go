				{
					"name": "1. update course 200 (3 pts)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let points = 0;",
									"",
									"pm.test(\"200 status code (1 pt)\", function () {",
									"    pm.response.to.have.status(200);",
									"    points += 1;",
									"});",
									"",
									"pm.test(\"content is valid (1.5 pts)\", function () {",
									"    const respJSON = pm.response.json();",
									"    pm.expect(respJSON[\"subject\"]).to.eq(\"CS\");",
									"    pm.expect(respJSON[\"number\"]).to.eq(594);",
									"    pm.expect(respJSON[\"title\"]).to.eq(\"Advanced Cloud Development\");",
									"    pm.expect(respJSON[\"term\"]).to.eq(\"winter-25\");",
									"    pm.expect(respJSON[\"instructor_id\"]).to.eq(pm.environment.get('instructor1_id'));",
									"    pm.expect(respJSON).to.have.property(\"updated_at\");",
									"    points += 1.5;",
									"});",
									"",
									"pm.test(\"self URL is valid (0.5 pts)\", function () {",
									"    const respJSON = pm.response.json();",
									"    pm.expect(respJSON[\"self\"]).to.eq(",
									"        \"https://\" + pm.environment.get(\"app_url\").replace(/^https?:\/\//, \"\") + '/courses/' + respJSON[\"id\"]);",
									"    points += 0.5;",
									"});",
									"",
									"console.log('******* Update course Test 1 points = ' + points);",
									"console.log('******* Update course Tests current points = ' + points);",
									"pm.environment.set(\"points_course_update\", points);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin1_jwt}}",
									"type": "string"
								}
							]
						},
